{
  "name": "skovbyesexologi-com",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm lint",
    "icons": "node scripts/gen-pose-icons.ts",
    "og": "node scripts/gen-og-images.ts",
    "prebuild": "node scripts/copy-sveltia.ts && node scripts/gen-portrait.ts",
    "portrait": "node scripts/gen-portrait.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": "~26",
    "pnpm": "~10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/material-symbols-outlined": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/noto-mono": "5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/mcp": "^0.1.31",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@sveltia/cms": "0.191.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/three": "^0.185.4",
    "@upscalerjs/esrgan-thick": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "sharp": "^0.35.5",
    "svelte": "^5.58.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "upscaler": "^1.0.0",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "marked": "^18.2.1",
    "three": "^0.185.1"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tensorflow/tfjs-node"
    ]
  }
}
